generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int           @id @default(autoincrement())
  nombreCompleto String
  email          String        @unique
  telefono       String
  password       String
  role           Role          @default(USER)
  createdAt      DateTime      @default(now())
  auditorias     Auditoria[]
  aprobaciones   Liquidacion[] @relation("AprobadoPor")
  recibos        Receipt[]
}

model Receipt {
  id          Int          @id @default(autoincrement())
  servicio    String
  mes         String
  monto       Float
  estado      EstadoRecibo @default(PENDIENTE)
  fechaSubida DateTime     @default(now())
  archivoUrl  String
  archivoPublicId String? 
  usuarioId   Int
  liquidacion Liquidacion?
  usuario     User         @relation(fields: [usuarioId], references: [id])
}

model Liquidacion {
  id            Int      @id @default(autoincrement())
  reciboId      Int      @unique
  fecha         DateTime @default(now())
  valorSubsidio Float
  valorTotal    Float
  aprobadoPorId Int
  aprobadoPor   User     @relation("AprobadoPor", fields: [aprobadoPorId], references: [id])
  recibo        Receipt  @relation(fields: [reciboId], references: [id])
}

model Auditoria {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  accion    String
  fecha     DateTime @default(now())
  detalles  String?
  usuario   User     @relation(fields: [usuarioId], references: [id])
}

enum Role {
  ADMIN
  USER
}

enum EstadoRecibo {
  PENDIENTE
  APROBADO
  RECHAZADO
}
